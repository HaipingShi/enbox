{
  "name": "enbox",
  "productName": "EnBox",
  "version": "0.2.3",
  "description": "自动识别语言、中英双向翻译的悬浮翻译盒",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/test-floating.cjs && node tests/test-translation.cjs && node tests/test-sse.mjs",
    "package": "electron-packager . EnBox --out=dist --icon=assets/enbox.icns --app-bundle-id=com.geesh.enbox --prune --overwrite",
    "package:win": "electron-packager . EnBox --platform=win32 --arch=x64 --out=dist --icon=assets/enbox.ico --app-bundle-id=com.geesh.enbox --prune --overwrite"
  },
  "devDependencies": {
    "@electron/packager": "^18.0.0",
    "electron": "^37.0.0"
  }
}
